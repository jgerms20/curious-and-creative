# Copy to .env (gitignored) and fill in. Names only here; never commit values.
# Anything left empty is simply unset, and dry runs (--dry-run) need none of it.

# Claude model IDs, one per tier. The repo never names a model; set the IDs you want here.
EARLOBE_MODEL_OPUS=
EARLOBE_MODEL_SONNET=
EARLOBE_MODEL_HAIKU=

# Anthropic API
ANTHROPIC_API_KEY=

# ElevenLabs text to speech
ELEVENLABS_API_KEY=
ELEVENLABS_TTS_MODEL=
# Voice IDs for the host personas in config/voices.yaml
VOICE_MARA=
VOICE_THEO=
VOICE_LENA=
VOICE_MARCUS=
VOICE_AVA=
VOICE_JUNE=

# CourtListener API token (court dockets)
COURTLISTENER_TOKEN=

# Transistor podcast host API key (optional; the local host needs nothing)
TRANSISTOR_API_KEY=

# Public base URL where audio and feeds are served, e.g. the site or bucket address
EARLOBE_PUBLIC_BASE_URL=

# Kill switch: "all", or comma-separated show ids (e.g. la-courts,cold-case-files)
EARLOBE_KILL=

# Optional: where runtime data lands (default: ./data)
EARLOBE_DATA_DIR=
